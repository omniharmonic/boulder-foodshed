        {
          "id": "blk_xbjk4q5mtt",
          "type": "accordion",
          "v": 1,
          "column": 1,
          "fields": {
            "items": [
              {
                "question": "Do I need to book?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "We keep half the tables for walk-ins. For groups of six or more, please book ahead."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Do you cater for allergies?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Yes. Tell your server and the kitchen will walk you through every dish. Most of the menu can be made gluten-free."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Is there parking?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "There's free street parking after 6pm and a public lot two minutes' walk away on Ash Street."
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "question": "Can I bring my dog?",
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Well-behaved dogs are very welcome on the patio, and there's always a water bowl by the door."
                        }
                      ]
                    }
                  ]
                }
              }
            ],
            "exclusive": false,
            "openFirst": true,
            "faqSchema": true
          },
          "variant": "lines"
        }
