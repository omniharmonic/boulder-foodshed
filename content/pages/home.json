          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Every basket you order earns you patronage. So does every crate a farm sells and every hour our crew drives. The books are open, and the co-op is governed one member, one vote. This is what \"local\" was supposed to mean."
                    }
                  ]
                }
              ]
            }
          },
          "variant": "default",
          "style": {
            "align": {
              "d": "center"
            }
