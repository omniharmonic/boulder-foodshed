              {
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "No. You choose your basket each week, you can skip a week, and it comes to your door."
                        }
                      ]
                    }
                  ]
                },
                "question": "Is this a CSA?"
              },
              {
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "No. A crew member shops the Boulder Farmers Market for your basket, and the label names every farm it came from. The crew who carry it own part of the co-op."
                        }
                      ]
                    }
                  ]
                },
                "question": "Is it Instacart?"
              },
              {
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Say so once and you'll never see it."
                        }
                      ]
                    }
                  ]
                },
                "question": "What if I hate cilantro?"
              },
              {
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Baskets close Wednesday at 8pm. The crew shops the market Saturday morning and delivers that afternoon."
                        }
                      ]
                    }
                  ]
                },
                "question": "When do I order, and when does it arrive?"
              },
              {
                "answer": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Not yet. Join the waitlist and we'll email you when baskets open."
                        }
                      ]
                    }
                  ]
                },
                "question": "Is it open yet?"
              }
            ],
            "exclusive": false,
