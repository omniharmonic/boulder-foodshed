      "blocks": [
        {
          "id": "blk_zq3ry797x8",
          "type": "component/week-path",
          "v": 1,
          "fields": {
            "eyebrow": "How the week works",
            "heading": "From the market stall to your door, in three steps.",
            "intro": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "You choose a size. The crew does the shopping. Everything else is already planned."
                    }
                  ]
                }
              ]
            },
            "steps": [
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The chef starts from what is in season and builds a menu around it. You pick a basket size, tell us what you never want, or say \"surprise me.\" Baskets close Wednesday at 8pm."
                        }
                      ]
                    }
                  ]
                },
                "title": "A local chef plans the week",
                "when": "Midweek"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A crew member walks the Boulder Farmers Market with the list and fills every basket at the stalls, straight from the people who grew it."
                        }
                      ]
                    }
                  ]
                },
                "title": "The crew shops the market",
                "when": "Saturday morning"
              },
              {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "One planned route carries the baskets out. Each comes with the week's recipes and a label naming every farm it came from."
                        }
                      ]
                    }
                  ]
                },
                "title": "One route brings it to your door",
                "when": "Saturday afternoon"
              }
            ]
          }
        }
      ]
    },
