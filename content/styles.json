{
  "$schema": "https://schema.openspace.host/v1/styles.json",
  "choices": {
    "palette": {
      "brand": "#c4402a",
      "neutral": "warm",
      "contrast": "standard",
      "source": "brand"
    },
    "pairing": "fraunces-hanken",
    "density": "comfortable",
    "shape": "round",
    "buttons": "pill-solid",
    "motion": "expressive",
    "imageTreatment": "rounded",
    "typography": {
      "heading": {
        "family": "Fraunces",
        "category": "serif",
        "weights": [
          600,
          700,
          800
        ],
        "italic": true
      },
      "body": {
        "family": "DM Sans",
        "category": "sans-serif",
        "weights": [
          400,
          500,
          600,
          700
        ]
      },
      "scale": {
        "display": {
          "size": 96,
          "sizeMobile": 42,
          "lineHeight": 1,
          "weight": 800
        },
        "h1": {
          "size": 64,
          "sizeMobile": 36,
          "lineHeight": 1.05,
          "weight": 800
        },
        "h2": {
          "size": 46,
          "sizeMobile": 29,
          "lineHeight": 1.1,
          "weight": 700
        },
        "h3": {
          "size": 32,
          "sizeMobile": 23,
          "lineHeight": 1.2,
          "weight": 700
        },
        "h4": {
          "size": 24,
          "sizeMobile": 19,
          "lineHeight": 1.3,
          "weight": 700
        },
        "lead": {
          "size": 22,
          "sizeMobile": 17,
          "lineHeight": 1.5
        },
        "body": {
          "size": 18,
          "sizeMobile": 16,
          "lineHeight": 1.6
        },
        "small": {
          "size": 14,
          "lineHeight": 1.5
        },
        "eyebrow": {
          "size": 14,
          "lineHeight": 1.3
        }
      }
    },
    "layout": {
      "contentWidth": 1200,
      "narrowWidth": 720
    }
  },
  "overrides": {
    "color": {
      "background": {
        "$value": "#f6edde",
        "$type": "color"
      },
      "surface": {
        "$value": "#ecdfc6",
        "$type": "color"
      },
      "text": {
        "$value": "#3b2a1f",
        "$type": "color"
      },
      "text-muted": {
        "$value": "#6a5442",
        "$type": "color"
      },
      "heading": {
        "$value": "#2a1a10",
        "$type": "color"
      },
      "border": {
        "$value": "#d8c7a6",
        "$type": "color"
      },
      "accent-text": {
        "$value": "#fff8ec",
        "$type": "color"
      },
      "accent": {
        "$value": "#c4402a",
        "$type": "color"
      },
      "dark": {
        "background": {
          "$value": "#3b2a1f",
          "$type": "color"
        },
        "text": {
          "$value": "#f6edde",
          "$type": "color"
        },
        "heading": {
          "$value": "#f6edde",
          "$type": "color"
        }
      }
    }
  }
}
